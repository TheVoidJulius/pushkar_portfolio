# ---------------------------------------------------------------------------
# Copy to .env.local for local development. In production, set these in
# Vercel → Project → Settings → Environment Variables. Never commit real keys.
# ---------------------------------------------------------------------------

# Supabase (Project Settings → API). The anon/publishable key is safe in the
# browser: Row Level Security protects all data.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public URL of the site (used for metadata and password-reset links)
NEXT_PUBLIC_SITE_URL=https://example-portfolio.vercel.app

# --- Optional, server-only -------------------------------------------------
# Claude API key for natural conversations (console.anthropic.com).
# Without it, the assistant answers from built-in rules using the same data.
ANTHROPIC_API_KEY=
# Optional model override (defaults to claude-opus-5-5)
ANTHROPIC_MODEL=

# ElevenLabs powers Mikuro's voice (elevenlabs.io). Server-only: never prefix with NEXT_PUBLIC_.
# Without a key Mikuro is text-only. It never silently swaps to a browser voice.
ELEVENLABS_API_KEY=
# Mikuro's permanent voice. This takes priority over the admin dashboard.
ELEVENLABS_VOICE_ID=e58ZQ25WJ8TTHDUkvhgh
# Optional tuning (defaults shown)
# ELEVENLABS_MODEL_ID=eleven_v3_conversational
# ELEVENLABS_STABILITY=0.5
# ELEVENLABS_SIMILARITY=0.8
# ELEVENLABS_STYLE=0.55
# ELEVENLABS_SPEED=0.96
# Most new characters the server may voice per day (cached audio is free)
# ELEVENLABS_DAILY_CHAR_LIMIT=2000
